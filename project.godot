; Engine configuration file.
config_version=5

[application]

config/name="Turbo Thruster"
config/description="Corrida arcade neon dentro de um túnel, inspirada em Torus Trooper."
config/version="2.0.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.png"

[autoload]

Save="*res://src/autoload/save.gd"
Sfx="*res://src/autoload/sfx.gd"
Mobile="*res://src/autoload/mobile.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1
window/dpi/allow_hidpi.web=false

[rendering]

renderer/rendering_method="mobile"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0, 0, 0, 1)

textures/vram_compression/import_etc2_astc=true
